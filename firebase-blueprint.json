{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Student profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "description": "Student email" },
        "studentId": { "type": "string", "description": "BUP Student ID" },
        "batch": { "type": "string", "description": "Batch name (e.g., BICE 2025)" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "role": { "type": "string", "enum": ["student", "admin"], "description": "User role" }
      },
      "required": ["uid", "displayName", "email", "studentId"]
    },
    "Resource": {
      "title": "Academic Resource",
      "description": "CT, Mid, or Final questions and materials",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Resource title" },
        "type": { "type": "string", "enum": ["CT", "Mid", "Final", "Other"], "description": "Type of resource" },
        "subject": { "type": "string", "description": "Subject name/code" },
        "fileUrl": { "type": "string", "description": "URL to the file" },
        "uploadedBy": { "type": "string", "description": "UID of the uploader" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Upload timestamp" }
      },
      "required": ["title", "type", "subject", "fileUrl", "uploadedBy"]
    },
    "Reminder": {
      "title": "Faculty Reminder",
      "description": "Important reminders from faculty or class reps",
      "type": "object",
      "properties": {
        "content": { "type": "string", "description": "Reminder message" },
        "facultyName": { "type": "string", "description": "Name of the faculty" },
        "dueDate": { "type": "string", "format": "date-time", "description": "Due date/time" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"], "description": "Priority level" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["content", "dueDate", "priority"]
    },
    "Event": {
      "title": "Batch Event",
      "description": "Calendar events for the batch",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Event title" },
        "description": { "type": "string", "description": "Event details" },
        "date": { "type": "string", "format": "date-time", "description": "Event date" },
        "type": { "type": "string", "enum": ["exam", "class", "social", "other"], "description": "Event type" }
      },
      "required": ["title", "date", "type"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/resources/{resourceId}": {
      "schema": "Resource",
      "description": "Academic resources"
    },
    "/reminders/{reminderId}": {
      "schema": "Reminder",
      "description": "Faculty reminders"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Batch events"
    }
  }
}
